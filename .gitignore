# 依赖与构建产物
node_modules/
.pnpm-store/
.cache/
dist/
out/
build/
*.log

# 运行时状态（窗口位置、Electron 用户数据）
packages/*/.state/
.state/

# 本地环境探针 / 一次性抓取脚本（诊断用，请勿入库）
_env_*.mjs
tools/_probe-*.mjs
tools/_crawl-*.mjs

# 接手复核的临时产物（`.audit/`）：探针脚本 + 软件光栅化出来的对照图。
# ⚠️ 里面的渲染图**含第三方 Live2D 角色**，与 docs/screenshots 同理由，禁止入库/分发。
# 复核结论文档是 docs/接手复核报告.md（那个要入库）。
/.audit/

# 打发行包的产物（tools/package-release.mjs 生成）
#   .release/     —— 暂存目录（复制一份完整源码树）
#   dist-release/ —— 成品 zip（精简版 ~1.7 MB / 完整版 ~155 MB）
/.release/
/dist-release/

# 安装脚本运行时产生的日志（tools/setup.mjs / 安装.cmd 每次运行都会重写）
/setup-log.txt
/install-log.txt

# 编辑器/系统
.vscode/
.idea/
Thumbs.db
desktop.ini
# Windows 快捷方式（含绝对路径，属于本机产物）
*.lnk

# 第三方桌宠/模型包（Live2DViewerEX 等）
# 这类文件是他人作品或加密商业格式，不属于本项目，禁止入库/分发
*.wpk
*.lpk
/Cyrene.zip
/Cyrene/
/3597924035_*.wpk

# 兜底：出现在任何位置的模型文件默认不入库（防误提交别人的模型）
*.moc3
*.motion3.json
*.exp3.json
*.physics3.json

# ✅ 例外：本项目正式使用的 Live2D 模型**已入库**（2026-10-06 起；经作者授权，
#    署名与用途要求见 NOTICE.md 第四节）。下面这行把 assets/live2d/ 从上面
#    4 条兜底规则里**重新包含**进来。
#      要改回「不入库」：**删掉下面这一行即可** —— 兜底规则会立刻重新挡住它。
#    模型修复逻辑在 tools/fix-live2d-model.mjs，可对任意副本重放。
!/assets/live2d/**

# 渲染端 vendor（第三方第三方库构建 + 官方 Cubism Core，由
# tools/prepare-renderer-vendor.mjs 生成，不入库）
/packages/pet-shell/renderer/vendor/

# 自检截图：**默认全部不入库**。
#   理由一：含第三方 Live2D 角色的截图不应随仓库分发（作者要求注明用途+不得收费）。
#   理由二：截图都能重跑生成（PET_SNAPSHOT=… node packages/pet-shell/scripts/launch.mjs）。
# 之前用"逐个文件名排除"，每加一种命名就漏一次（连漏两回），所以改成整目录黑名单+白名单例外。
docs/screenshots/*
!docs/screenshots/phase0-smoke.png
!docs/screenshots/phase0-live.png
